rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatar images — path includes userId for ownership validation
    match /avatars/{userId}/{type}/{fileId} {
      // Anyone can read avatars
      allow read: if true;

      // Only the owning user can upload their own avatars
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Legacy path — read-only for backwards compatibility with existing avatars
    match /avatars/{type}/{fileId} {
      allow read: if true;
      allow write: if false;
    }

    // Chat images
    match /chat/{leagueId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Ben's model artifacts — uploaded from the Track Limits admin page.
    // Versioned by upload timestamp in the filename. Authed-user read+write;
    // the admin page enforces the human allowlist on its end (rules can't
    // enforce arbitrary email whitelist without custom claims).
    match /ben/models/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024  // 50MB cap
                   && filename.matches('.*\\.(py|json|csv|md|txt|zip)');
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
