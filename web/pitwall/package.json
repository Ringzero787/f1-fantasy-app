{
  "name": "undercut-pitwall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Undercut Pit Wall web portal (F-075). Served by Cloudflare Pages; deployed only through the pitwall-pages-deploy aidlc op.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . --noEmit && vite build",
    "build:preview": "tsc -p . --noEmit && vite build --mode preview",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:scroll": "node tests/scroll-budget.mjs"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
