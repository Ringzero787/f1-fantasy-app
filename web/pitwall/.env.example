# Copy to .env.local (never committed). These are the Firebase WEB app values: public identifiers, not secrets.
# Until the owner registers a dedicated Web app for the portal, the values in the repository root's .env
# (EXPO_PUBLIC_FIREBASE_*) work, because the Undercut app already uses the Firebase JS SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=f1-app-18077
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
