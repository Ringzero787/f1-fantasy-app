# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Google OAuth (for Google Sign-In)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id
GOOGLE_IOS_CLIENT_ID=your-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id

# Sign in with Apple on the Play and Amazon builds (F-091). The Apple *Services ID*, which is a
# different client identifier from the iOS bundle id. Leave it empty and the Apple pill stays hidden
# on non-iOS builds rather than offering a button that cannot work.
EXPO_PUBLIC_APPLE_SERVICES_ID=
# Only to point the flow somewhere else; defaults to the Firebase Hosting rewrite.
# EXPO_PUBLIC_APPLE_REDIRECT_URI=https://f1-app-18077.web.app/undercut/auth/apple

# Login with Amazon (F-091). The client id of the Login with Amazon security profile, and our
# own return URL. Setting the return URL switches on the hardened flow — where Amazon's
# authorization code is filed server-side instead of coming back to the device on a custom scheme —
# which is also what lets the button be offered on the Play and iOS builds. Register it as an
# allowed return URL in the LWA security profile first.
EXPO_PUBLIC_AMAZON_CLIENT_ID=
# EXPO_PUBLIC_AMAZON_REDIRECT_URI=https://f1-app-18077.web.app/undercut/auth/amazon
