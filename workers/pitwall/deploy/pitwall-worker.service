[Unit]
Description=Undercut Pit Wall worker (projections, wire, forecast; pull-based pw_jobs queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nathan
Group=nathan
WorkingDirectory=/data/pitwall-worker/current
EnvironmentFile=/data/pitwall-worker/env
ExecStart=/usr/bin/node /data/pitwall-worker/current/dist/workers/pitwall/src/cli/serve.js
Restart=always
RestartSec=15
# Sandbox. The outlooks call the Claude Code CLI on the studio's subscription (F-071), so the
# service needs the binary and one credential — and nothing else of the operator's. /home is a
# tmpfs and HOME points into the worker's own directory; the binary is bound read-only; the single
# credentials file is bound into a config
# directory of the worker's own. `~/.claude` itself is never mounted: it holds the maintainer's
# transcripts, notes and hook scripts, and a worker able to write there could run code outside
# this unit the next time the maintainer opened a session.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/nathan/.local/bin /home/nathan/.local/share/claude
BindPaths=/home/nathan/.claude/.credentials.json:/data/pitwall-worker/claude/.credentials.json
Environment=HOME=/data/pitwall-worker/home
Environment=CLAUDE_CONFIG_DIR=/data/pitwall-worker/claude
PrivateTmp=true
ReadWritePaths=/data/pitwall-worker
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

# Installed by the `pitwall-worker-deploy` op (scripts/ops/pitwall-worker-deploy.sh), never by hand.
# Logs:  journalctl -u pitwall-worker -f
