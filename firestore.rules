rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isLeagueMember(leagueId) {
      return exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
    }

    function isLeagueOwner(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // F-056: write privileges inside a league (chat, invites, replies, count)
    // need an APPROVED member; a join still awaiting approval does not count.
    // Reads keep using isLeagueMember: released clients detect their own
    // pending state by querying the members list.
    function isApprovedLeagueMember(leagueId) {
      let path = /databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid);
      return exists(path) && get(path).data.get('status', 'approved') != 'pending';
    }

    // F-056: joining a league — it must exist, have room, and the new member's
    // status must match the league's approval setting.
    function memberMayJoin(leagueId, status) {
      let league = get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      let settings = league.get('settings', {});
      let needsApproval = settings is map && settings.get('requireApproval', false) == true;
      return league.memberCount < league.maxMembers
             && ((needsApproval && status == 'pending') || (!needsApproval && status == 'approved'));
    }

    // Users collection — only the owner can read/write their own profile
    // SECURITY: prevent users from setting isAdmin field on themselves
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && !('isAdmin' in request.resource.data)
                    && !('pass' in request.resource.data)
                    && !('pwTrialUsed' in request.resource.data);
      allow update: if isOwner(userId)
                    // F-068: the pass, its trial flag and the revocation record are server-owned
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'pass', 'pwTrialUsed', 'pwRevoked']);
      allow delete: if isOwner(userId);

      // F-071: what this person has read and rated on the Pit Wall wire. Private to them: it is
      // a reading history, so no admin read either. Two maps and a timestamp, nothing else, so a
      // client cannot park arbitrary data here.
      match /pitwall/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
                     && docId == 'wire'
                     && request.resource.data.keys().hasOnly(['read', 'liked', 'updatedAt'])
                     && request.resource.data.read is map
                     && request.resource.data.liked is map;
      }
    }

    // Leagues collection
    // F-105: the free tier's member ceiling. Beyond it is the league-expansion IAP, applied by
    // `applyLeagueExpansion` in twenty-slot steps — never by the client. Mirrors
    // DEFAULT_MAX_MEMBERS / FREE_LEAGUE_MEMBER_LIMIT in src/config/constants.ts.
    function freeLeagueCeiling() { return 22; }

    match /leagues/{leagueId} {
      allow read: if isAuthenticated();
      // F-105: `allow create: if isAuthenticated()` constrained NOTHING, so a signed-in player
      // could mint a league with the paid features already switched on:
      //   • `pro: true` with a far-future `proUntil` — and `pro == true` is exactly what
      //     `startLeagueTrial` checks before granting a Pit Wall pass trial. The F-068 guard
      //     below only blocks these on UPDATE, which is the half nobody reaches.
      //   • `maxMembers` up to anything — walking around the league-expansion IAP entirely. The
      //     legacy create screen offers 2–100 and gates it on a client-side credit check, which
      //     is exactly the arrangement `applyLeagueExpansion` was written to replace.
      //   • somebody else's `ownerId`.
      // So creation now writes a FREE league owned by whoever is creating it, and every paid
      // attribute arrives afterwards from a function.
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberCount == 1
                    && request.resource.data.maxMembers is int
                    && request.resource.data.maxMembers >= 2
                    && request.resource.data.maxMembers <= freeLeagueCeiling()
                    // Pro is derived from the owner's pass and stamped by passStore; absent or
                    // explicitly off is the only honest starting state.
                    && (!('pro' in request.resource.data) || request.resource.data.pro == false)
                    && (!('proUntil' in request.resource.data) || request.resource.data.proUntil == null);
      // F-056: the owner edits league details but can never hand the league to
      // someone else, and capacity never shrinks under the current head count.
      // Everyone else may only move memberCount by one, and only in step with
      // their own member doc (join: approved member, within capacity; leave: doc gone), never below 0.
      // Residual: released clients delete their member doc BEFORE decrementing, so
      // a leaver is indistinguishable from an outsider here, and a member can
      // re-join to push the count up; it stays a client-maintained hint until a
      // Cloud Function owns it (F-059).
      allow update: if isAuthenticated() && (
        (
          isLeagueOwner(leagueId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.maxMembers >= resource.data.maxMembers
          // F-068: League Pro is derived from the owner's pass and stamped by a function;
          // an owner setting it by hand would hand themselves the paid features.
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pro', 'proUntil'])
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
          && (
            (request.resource.data.memberCount == resource.data.memberCount + 1
                && isApprovedLeagueMember(leagueId)
                // +1 of slack: once the server recount is live (F-059) it may land before a
                // released client's own increment at the last free slot; the recount then
                // puts the truth back.
                && request.resource.data.memberCount <= resource.data.maxMembers + 1)
            || (request.resource.data.memberCount == resource.data.memberCount - 1
                && !isLeagueMember(leagueId)
                && request.resource.data.memberCount >= 0)
          )
        )
      );
      allow delete: if isLeagueOwner(leagueId);

      // League members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          isLeagueMember(leagueId) ||
          isLeagueOwner(leagueId) ||
          isOwner(memberId)
        );
        // F-056: a member doc can only be created BY that user FOR that user,
        // with a clean scoring state. `owner` is reserved for the league's own
        // owner (createLeague writes league + owner member in one batch, hence
        // getAfter). Joining respects capacity and the approval setting.
        // Points, ranks and movement fields are written by Cloud Functions.
        allow create: if isAuthenticated()
                      && isOwner(memberId)
                      && request.resource.data.keys().hasOnly(
                           ['leagueId', 'userId', 'displayName', 'role', 'status', 'totalPoints', 'rank', 'joinedAt'])
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.leagueId == leagueId
                      && request.resource.data.totalPoints == 0
                      && request.resource.data.displayName is string
                      && request.resource.data.displayName.size() <= 60
                      && request.resource.data.rank is int
                      && request.resource.data.rank >= 0
                      && (
                        (
                          request.resource.data.role == 'owner'
                          && getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerId == request.auth.uid
                        ) || (
                          request.resource.data.role == 'member'
                          && memberMayJoin(leagueId, request.resource.data.status)
                        )
                      );
        // The owner manages role, approval and rank; a member may only fix
        // their own display name. Nobody on a client touches points.
        allow update: if isAuthenticated() && (
          (
            isLeagueOwner(leagueId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'rank'])
            && request.resource.data.get('role', 'member') in ['owner', 'admin', 'member']
            && (request.resource.data.get('role', 'member') == 'owner') == (resource.data.get('role', 'member') == 'owner')
          ) || (
            isOwner(memberId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 60
          )
        );
        allow delete: if isLeagueOwner(leagueId) || isOwner(memberId);
      }

      // F-062: per-race leaderboard and winners, written by scoring only.
      match /raceResults/{raceId} {
        allow read: if isAuthenticated() && (isLeagueMember(leagueId) || isLeagueOwner(leagueId));
        allow write: if false;
      }

      // F-107: the league's season history (Moonshot hits, misses, voids), written by settlement only.
      match /activity/{entryId} {
        allow read: if isAuthenticated() && (isLeagueMember(leagueId) || isLeagueOwner(leagueId));
        allow write: if false;
      }

      // League invites — members can create (max enforced by Cloud Function rate limit)
      // SECURITY: limit invite doc size to prevent abuse
      match /invites/{inviteId} {
        allow read: if isAuthenticated() && (isLeagueMember(leagueId) || isLeagueOwner(leagueId));
        allow create: if isApprovedLeagueMember(leagueId)
                      && request.resource.data.keys().hasOnly(['email', 'status', 'sentBy', 'createdAt', 'expiresAt'])
                      && request.resource.data.email is string
                      && request.resource.data.email.size() < 256;
        allow update, delete: if isLeagueOwner(leagueId);
      }

      // League announcements subcollection
      match /announcements/{announcementId} {
        allow read: if isAuthenticated() && isLeagueMember(leagueId);
        allow create: if isAuthenticated() && isLeagueOwner(leagueId);
        allow update: if isAuthenticated() && isLeagueOwner(leagueId);
        allow delete: if isAuthenticated() && isLeagueOwner(leagueId);

        match /replies/{replyId} {
          allow read: if isAuthenticated() && isLeagueMember(leagueId);
          allow create, update: if isAuthenticated() && isApprovedLeagueMember(leagueId);
          allow delete: if false;
        }
      }

      // Chat messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (isLeagueMember(leagueId) || isLeagueOwner(leagueId) || isAdmin());
        allow create: if isAuthenticated() && (isApprovedLeagueMember(leagueId) || isLeagueOwner(leagueId))
                      && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() && (isApprovedLeagueMember(leagueId) || isLeagueOwner(leagueId))
                      && (resource.data.senderId == request.auth.uid
                          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']));
        allow delete: if isAuthenticated()
                      && (resource.data.senderId == request.auth.uid || isLeagueOwner(leagueId) || isAdmin());
      }

      match /chatReadReceipts/{userId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Drivers collection (read-only for users)
    match /drivers/{driverId} {
      allow read: if true;
      allow write: if false;
    }

    // Constructors collection (read-only for users)
    match /constructors/{constructorId} {
      allow read: if true;
      allow write: if false;
    }

    // Fantasy teams collection — SERVER-AUTHORITATIVE roster & economy (same
    // model as tl_garages below). The owner can update metadata only (name,
    // avatar, ace, leagueId). Everything that represents value or scoring —
    // roster, budget, points, locks — is written exclusively by Cloud
    // Functions (Admin SDK bypasses these rules): createTeamSecure,
    // buildTeamSecure, addDriverSecure, removeDriverSecure,
    // setConstructorSecure, removeConstructorSecure, onRaceCompleted.
    // Undercut Pit Wall (F-075): sign-in handoff codes, their rate-limit counters, and the compute
    // worker's queue and run records are touched by the Admin SDK only. No client access at all.
    match /pw_handoffs/{id} { allow read, write: if false; }
    match /pw_handoff_limits/{id} { allow read, write: if false; }
    match /pw_jobs/{id} { allow read, write: if false; }
    match /pw_runs/{id} { allow read, write: if false; }
    match /pw_grants/{id} { allow read, write: if false; }
    // Cross-store sign-in (F-091): each document holds an Apple identity token for ten minutes
    // while the browser hands it back to the device. Written by appleAuthRedirect and read once by
    // claimAppleSignIn, both Admin SDK. A client that could read this collection could sign in as
    // whoever is mid-sign-in, so the denial is written out rather than left to the default.
    match /auth_handoff/{id} { allow read, write: if false; }

    // Pit Wall Pass (F-068). The paywall is enforced here, not only in the UI: paid payloads need
    // the `pw` claim, which functions stamp from users/{uid}.pass and no client can forge. The free
    // look and every timing-derived frame (never sold, ADR-001) need only a signed-in user.
    function hasPass() {
      return isAuthenticated()
             && request.auth.token.pw is number
             && request.auth.token.pw * 1000 > request.time.toMillis();
    }
    match /pw_public/{id} { allow read: if isAuthenticated(); allow write: if false; }
    match /pw_public_timing/{id} { allow read: if isAuthenticated(); allow write: if false; }
    match /pw_news/{id} { allow read: if isAuthenticated(); allow write: if false; }
    match /pw_pages/{id} { allow read: if hasPass(); allow write: if false; }
    match /pw_entities/{id} { allow read: if hasPass(); allow write: if false; }
    match /pw_projections/{id} { allow read: if hasPass(); allow write: if false; }
    // F-072: ownership and lineups per league per round, for that league's members and owner only —
    // the same people the app shows those lineups to. Written by the worker.
    match /pw_leagues/{id} { allow read: if isAuthenticated() && (isLeagueMember(resource.data.leagueId) || isLeagueOwner(resource.data.leagueId)); allow write: if false; }

    // F-095/F-098: the ace doubles a pick's points, and three sessions score with it
    // applied — qualifying, the sprint, and the race. Each is scored by its own job
    // minutes after the session ends, reading the ace live, so for each of them there was
    // a window in which you could watch the session and then point your ace at whoever
    // had won it. autoLockTeams stamps the weekend's freeze on every team it covers;
    // `lockStatus` is a denied key below, so none of it is the client's to move.
    //
    // The freeze runs from the first scoring session to the failsafe ceiling, with ONE
    // deliberate gap: once qualifying has been scored and before the race starts, the ace
    // moves freely. That gap is the feature — choosing your ace on the strength of
    // qualifying is the point of the ace — and it opens on `scoredRaces` carrying the
    // qualifying key rather than on a time we guessed, so it cannot open before the
    // points it would otherwise change are banked. `scoredRaces` is a denied key too.
    // When qualifying cannot be scored on the day (an unmapped driver; it is folded in at
    // race time instead) the gap simply never opens, which is the right answer: the ace
    // is still live for those points.
    //
    // It is a WINDOW, with an end, and that is deliberate. Keying off `isLocked` instead
    // would have made the ace reachable through any callable that clears the lock
    // (season-lock then pay the early-unlock fee, mid-race) and would have frozen the ace
    // for ever on a team nothing ever unlocks. A window needs no help: it cannot be
    // opened early, and a stamp nobody clears expires on its own.
    //
    // `.get(…, default)` throughout: reading a field that is not there is an error, and
    // an error denies — a team written before these fields existed has no window, and one
    // stamped by F-095 before the freeze start existed falls back to the race start it
    // already carries.
    // F-104: a `leagueId` has to be something `doc()` can take.
    //
    // `db.collection('leagues').doc(id)` throws SYNCHRONOUSLY on an id containing a slash, and
    // nothing validated this field: any signed-in player could create a team with
    // `leagueId: "a/b"` and reject every `autoLockTeams` run from then on — no lineup lock, no
    // ace freeze, for everyone, until someone found the document. The same shape reaches
    // `rankLeagueMembers` and `leagueRaceResultsWriter` off the scoring path.
    //
    // Real ids are Firestore auto-ids (`doc(leaguesCollection)` in league.service.ts): twenty
    // characters of [A-Za-z0-9]. This is deliberately looser than that — a single path segment
    // of word characters — so it constrains the shape without betting on the generator, and the
    // short ids the rules tests use still pass.
    //
    // Null and absent are both fine: a solo team has no league, and 45 of the 77 teams in
    // production are solo with one older team missing the field entirely.
    //
    // It is checked on UPDATE as well as create, because `leagueId` is not on the denied-key
    // list — `syncTeam` writes it on every sync — so a create-only rule would leave the hole
    // open to anyone who created a team properly and then edited it.
    // The first character must be alphanumeric, which is how an id beginning `__` is excluded:
    // Firestore reserves `__…__` and throws on it just as it does on a slash, and RE2 — what
    // `matches()` runs — has no negative lookahead to say it directly. `__proto__` passed the
    // first version of this rule and was caught by the test, not by me.
    function usableLeagueId(data) {
      let id = data.get('leagueId', null);
      return id == null
             || (id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[A-Za-z0-9][A-Za-z0-9_-]*$'));
    }

    function aceIsFrozen(team) {
      // Nine `let`s. Firestore allows ten per function and refuses to compile at eleven,
      // which is why the conditions below are packed rather than named one per line.
      let ls = team.get('lockStatus', {});
      let raceStart = ls is map ? ls.get('aceLockTime', null) : null;
      // A type test, not a default: `get(k, default)` gives the default only when the key
      // is ABSENT, and a present null is exactly what createTeamSecure and the rescue
      // script write. Reading that as "no freeze" left those teams wide open.
      let stamped = ls is map ? ls.get('aceFreezeFrom', null) : null;
      let from = stamped is timestamp ? stamped : raceStart;
      let until = ls is map ? ls.get('aceLockUntil', null) : null;
      let scored = team.get('scoredRaces', []) is list ? team.get('scoredRaces', []) : [];
      let qualiMark = ls is map && ls.get('aceQualiKey', '') is string ? ls.get('aceQualiKey', '') : '';
      let sprintMark = ls is map && ls.get('aceSprintKey', '') is string ? ls.get('aceSprintKey', '') : '';
      // The gap: qualifying scored, the sprint settled where there is one, race not yet
      // started. Either session can miss its own scoring run and be folded into race
      // scoring instead, read live — so neither may be assumed done.
      let gapOpen = qualiMark != '' && scored.hasAny([qualiMark])
                    && (sprintMark == '' || scored.hasAny([sprintMark]))
                    && raceStart is timestamp && request.time < raceStart;
      return from is timestamp && until is timestamp
             && request.time >= from && request.time < until
             && !gapOpen;
    }

    // Compared by VALUE, not by affectedKeys: scoring removes the ace fields outright
    // (`FieldValue.delete()`) when a weekend ends with no ace, while the app's sync spells
    // the same thing as an explicit null. Absent-versus-null is a diff, so a keys-based
    // test would have refused an innocent write — a rename, say — for anyone who went into
    // a race without an ace, and syncTeamToFirebase only logs what it is refused.
    function aceUnchanged(before, after) {
      return before.get('aceDriverId', null) == after.get('aceDriverId', null)
             && before.get('aceConstructorId', null) == after.get('aceConstructorId', null);
    }

    match /fantasyTeams/{teamId} {
      // F-029: roster and points per race weekend, written by scoring only. Readable by
      // the team's owner and by the team's league (the same people who can see the team).
      match /raceSnapshots/{raceId} {
        allow read: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          isAdmin() ||
          (resource.data.leagueId != null && (isLeagueMember(resource.data.leagueId) || isLeagueOwner(resource.data.leagueId)))
        );
        allow write: if false;
      }

      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isLeagueMember(resource.data.leagueId) ||
        isLeagueOwner(resource.data.leagueId) ||
        isAdmin()
      );
      allow list: if isAuthenticated();
      // Create allowed only with a pristine financial state — a client cannot
      // mint a team with extra budget, a pre-filled roster, or points.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.budget == 1000
                    && request.resource.data.totalSpent == 0
                    && request.resource.data.totalPoints == 0
                    && request.resource.data.drivers.size() == 0
                    && request.resource.data.constructor == null
                    && (!('lockedPoints' in request.resource.data) || request.resource.data.lockedPoints == 0)
                    && (!('scoredRaces' in request.resource.data) || request.resource.data.scoredRaces.size() == 0)
                    // F-107: the Moonshot column is settlement's alone; a new team starts with none
                    && (!('moonshotPoints' in request.resource.data) || request.resource.data.moonshotPoints == 0)
                    && !('moonshotStats' in request.resource.data)
                    && usableLeagueId(request.resource.data);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'totalPoints', 'lockedPoints', 'scoredRaces',
                      'isLocked', 'lockStatus',
                      'drivers', 'constructor', 'budget', 'totalSpent',
                      'racesSinceTransfer', 'driverLockouts',
                      'bestRacePoints', 'bestRaceId',
                      'moonshotPoints', 'moonshotStats'
                    ]))
                    && (!aceIsFrozen(resource.data) || aceUnchanged(resource.data, request.resource.data))
                    && usableLeagueId(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    // Races collection (read-only for users)
    match /races/{raceId} {
      allow read: if true;
      allow write: if false;

      match /results/{resultId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Seasons collection (read-only)
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if false;
    }

    // Price history (read-only)
    match /priceHistory/{historyId} {
      allow read: if true;
      allow write: if false;
    }

    // Collection group query for league members
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == memberId ||
        resource.data.userId == request.auth.uid
      );
    }

    // Articles — authenticated users can read, only admins can write
    match /articles/{articleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Error logs — users can create, only admins can read, immutable
    match /errorLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Purchases collection — users can read their own, only Cloud Functions can write
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Notifications — users can only read/update their own
    match /notifications/{notificationId} {
      allow get: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated(); // Firestore can't enforce userId filter on list
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
    }

    // Avatar rate limits — Cloud Functions only
    match /avatarRateLimits/{userId} {
      allow read, write: if false;
    }

    // Pending results — admin only
    match /pendingResults/{resultId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Race scores — per-driver/constructor per-race scoring breakdown (read-only)
    match /raceScores/{scoreId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Moonshot (F-106). A call is the owner's until it locks; after lock the league sees it
    // (hideBeforeLock is fixed on here: rules cannot read config). Quotes are server-only.
    // Models are the weekly model everyone may read: pricing is never behind the pass. The
    // token count is the owner's. Nothing here is client-writable; the callables are the only writers.
    match /moonshots/{moonshotId} {
      allow get, list: if isAuthenticated() && (
        isOwner(resource.data.userId) || isAdmin()
        || (resource.data.leagueId != null && isLeagueMember(resource.data.leagueId)
            && resource.data.status != 'CANCELLED'
            && resource.data.lockAt != null && resource.data.lockAt <= request.time)
      );
      allow write: if false;
    }
    match /moonshotQuotes/{quoteId} {
      allow read, write: if false;
    }
    match /moonshotModels/{raceId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /moonshotTokens/{teamSeason} {
      allow get: if isAuthenticated() && isOwner(resource.data.userId);
      allow list, write: if false;
    }

    // Game config — readable by all authenticated users, writable by admin only
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Cache — authenticated users can read, only Cloud Functions write
    match /cache/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================================
    // Track Limits (sibling app — sibling collections prefixed tl_)
    // ============================================================

    function isTLLeagueMember(leagueId) {
      return exists(/databases/$(database)/documents/tl_leagues/$(leagueId)/members/$(request.auth.uid));
    }

    function isTLLeagueOwner(leagueId) {
      return get(/databases/$(database)/documents/tl_leagues/$(leagueId)).data.ownerId == request.auth.uid;
    }

    // A TL race session is locked once its scheduled start has passed (server
    // clock) or the race is completed/cancelled. Mirrors the server-side
    // assertSessionOpen used by the pick/bet callables, so a client can't edit a
    // lineup after the session that scores it has begun.
    function tlSessionLocked(raceId, session) {
      let race = get(/databases/$(database)/documents/races/$(raceId));
      return race != null && (
        race.data.status == 'completed' || race.data.status == 'cancelled' ||
        (session in race.data.schedule &&
         race.data.schedule[session] != null &&
         request.time >= race.data.schedule[session])
      );
    }

    // A lineup slot is "idle" (no entries) — safe to write for an already-locked
    // session on create, since it can't encode post-lock knowledge.
    function tlSlotIdle(data, session) {
      return !(session in data) || (
        data[session].startedDriverIds.size() == 0 &&
        data[session].get('startedConstructorId', null) == null
      );
    }

    // TL user profiles — only the owner can read/write their own.
    // Updates may not set displayName to a signup placeholder: 0.1.34/0.1.35
    // builds could save the literal "Player" over a real name (stale local
    // snapshot with no email degraded the call-sign fallback), re-arming the
    // call-sign prompt forever. Create stays unrestricted — guest sign-in
    // legitimately creates "Demo XXXX" profiles.
    match /tl_users/{userId} {
      allow read, create, delete: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'].toSet())
                        || !(request.resource.data.displayName in ['Player', 'Track Limits Player']));
    }

    // TL garage — SERVER-AUTHORITATIVE economy. The owner can read their garage
    // and change ONLY their active roster (rosteredDriverIds/rosteredConstructorIds).
    // Everything that represents value — cash, totals, owned entities, roster slot
    // counts, streaks — is written exclusively by Cloud Functions (Admin SDK,
    // which bypasses these rules): tlBuyDriver/tlReleaseDriver/tlChargeReroll,
    // tlPlace*Bet, tlActivateInsurance, tlOnRaceCompleted, applyEntitlement, etc.
    // Create is server-only (tlInitialRoll / tlCommitRoll) so a client cannot
    // mint a garage with arbitrary cash.
    match /tl_garages/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if false;
      allow update: if isAuthenticated() && isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['rosteredDriverIds', 'rosteredConstructorIds', 'updatedAt']);
      allow delete: if false;

      // Transaction history — owner can read; append is SERVER-ONLY so the log
      // can't be forged. Update/delete denied so it stays append-only.
      match /transactions/{txId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // TL lineups — doc ID is {userId}_{raceId}; userId field on doc is authoritative.
    // Lineups are the SCORING INPUT, so writes are time-locked against the race's
    // own schedule: you may edit a session's slot only while that session is still
    // open. The qualifying slot locks at qualifying start; the race slot at race
    // start. (Enforced here because lineup writes are client-direct — unlike the
    // cash callables, which gate via assertSessionOpen.)
    match /tl_lineups/{lineupId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Create: owner-only; a slot for an already-locked session must be idle so a
      // first-time lineup can't be minted with post-lock knowledge.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && (!tlSessionLocked(request.resource.data.raceId, 'qualifying')
                        || tlSlotIdle(request.resource.data, 'qualifying'))
                    && (!tlSessionLocked(request.resource.data.raceId, 'race')
                        || tlSlotIdle(request.resource.data, 'race'));
      // Update: owner-only, identity preserved; a locked session's slot must be
      // unchanged (deep-equal). Editing the race slot before the race starts is
      // fine even after qualifying has locked, and vice-versa.
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && (!tlSessionLocked(resource.data.raceId, 'qualifying')
                        || request.resource.data.qualifying == resource.data.qualifying)
                    && (!tlSessionLocked(resource.data.raceId, 'race')
                        || request.resource.data.race == resource.data.race);
      allow delete: if false;
    }

    // TL leagues
    match /tl_leagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      // Members can update memberCount (via join transaction); owner can update everything else.
      allow update: if isAuthenticated() && (
        isTLLeagueOwner(leagueId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && isTLLeagueOwner(leagueId);

      // League members — anyone authed can read (for leaderboard); join writes own member doc.
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && memberId == request.auth.uid;
        allow update: if isAuthenticated() && (memberId == request.auth.uid || isTLLeagueOwner(leagueId));
        allow delete: if isAuthenticated() && (memberId == request.auth.uid || isTLLeagueOwner(leagueId));
      }

      // Ledger entries — members can read everything (for leaderboard transparency),
      // any member can append their own entry, status updates from owner or affected user.
      match /ledger/{entryId} {
        allow read: if isAuthenticated() && (isTLLeagueMember(leagueId) || isTLLeagueOwner(leagueId));
        allow create: if isAuthenticated() && (isTLLeagueMember(leagueId) || isTLLeagueOwner(leagueId))
                      && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          isTLLeagueOwner(leagueId) ||
          resource.data.userId == request.auth.uid
        );
        allow delete: if isAuthenticated() && isTLLeagueOwner(leagueId);
      }

      // Settlements — two-step "I sent it" / "I received it" flow.
      match /settlements/{settlementId} {
        allow read: if isAuthenticated() && (isTLLeagueMember(leagueId) || isTLLeagueOwner(leagueId));
        allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
        // Only the recipient can confirm; only sender can dispute.
        allow update: if isAuthenticated() && (
          (resource.data.toUserId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedByToAt'])) ||
          (resource.data.fromUserId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        );
        allow delete: if false;
      }
    }

    // TL race scores — written by tlOnRaceCompleted Cloud Function, read by anyone authed.
    match /tl_scores/{scoreId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // TL entitlements — owner reads their own; writes via Cloud Functions only.
    match /tl_entitlements/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }

    // TL purchases — owner reads their own; writes via Cloud Functions only.
    match /tl_purchases/{purchaseId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // TL webhook log — admin/debug only.
    match /tl_webhook_log/{logId} {
      allow read, write: if false;
    }

    // TL remote app config — publicly readable so the launch-time gate
    // (force-update / notice) works before sign-in. Writes via console/admin only.
    match /tl_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // TL insurance — owner reads their own; writes are SERVER-ONLY (premiums and
    // the cash debit/refund run in tlActivateInsurance / tlDropInsurance via the
    // Admin SDK). Doc ID is `${userId}_${raceId}`; userId field is authoritative.
    match /tl_insurance/{insuranceId} {
      allow get: if isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
      // No collection queries — the app only reads its own doc by id, so listing
      // is denied to avoid leaking other players' data.
      allow list: if false;
      allow create, update, delete: if false;
    }

    // TL bets — same model as insurance. Stakes/odds/payouts and the cash
    // debit/refund run server-side (tlPlace*Bet / tlCancelBet); settlement by
    // tlOnRaceCompleted. Client writes denied.
    match /tl_bets/{betsId} {
      allow get: if isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
      // No collection queries — the app only reads its own doc by id, so listing
      // is denied to avoid leaking other players' data.
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Ben's posted lines — read by anyone authed. Writes are SERVER-ONLY:
    // production lines come from the tlGenerateBenLinesLite / backfillBenLines
    // Cloud Functions via the Admin SDK (which bypasses these rules), and
    // actual results are written at settlement. Client writes are denied so a
    // player cannot rewrite the book's odds/results in their favour.
    // NOTE: the in-app Demo screen (app/demo.tsx) can no longer seed lines
    // directly — it must call the SEED_SECRET-gated HTTP seeder instead.
    match /ben_lines/{lineId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Admin-page UI prefs (e.g. last-selected race). Owner-only — keyed by uid.
    match /tl_admin_prefs/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Player picks — one doc per (user, race), owned by the user. Picks default
    // to side='with', stake=0. Settlement fields (settled/weekendPoints/etc) are
    // only ever written by tlSettleWeekend via the Admin SDK, which bypasses
    // these rules — so the diff/affectedKeys defense was redundant + was
    // misfiring on serverTimestamp() vs Timestamp comparisons during normal
    // client writes. Keep ownership checks; drop the diff check.
    match /tl_picks/{pickId} {
      // Picks are SERVER-AUTHORITATIVE: a stake escrows real cash, so all writes
      // go through the tlSetPick callable (and settlement via tlSettleWeekend),
      // both Admin SDK. Clients may only read their own picks; doc id encodes
      // {userId}_{raceId}. GET requires only auth (not a resource.data.userId
      // match) to tolerate stale userIds from early anonymous→Google rebinds.
      allow get: if isAuthenticated();
      // No collection queries — the app only reads its own pick doc by id, so
      // listing is denied to avoid leaking other players' picks.
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Per-weekend per-user score — written by tlSettleWeekend, read for the
    // weekly leaderboard. Anyone authed can read for cross-league comparison.
    match /tl_weekend_scores/{scoreId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Running season totals per user — written by tlSettleWeekend on each race
    // settlement, read for the season leaderboard.
    match /tl_season_scores/{scoreId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // TL in-app notification history — written SERVER-ONLY (sendPushToTLUser via
    // the Admin SDK); the owner reads their own for an in-app inbox/badge.
    match /tl_notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
